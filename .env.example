# Número de WhatsApp de contacto, formato internacional sin signos (ej. 5215512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endpoint opcional al que se enviarán los leads (Zapier, Make, n8n, CRM, etc.)
# Si se deja vacío, submitLead() solo hace log local y no falla el formulario.
LEADS_WEBHOOK_URL=

# ID de medición de Google Analytics 4 (formato G-XXXXXXX). Opcional: sin él,
# los eventos de conversión solo se registran en window.dataLayer.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
