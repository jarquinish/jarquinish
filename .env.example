# Número de WhatsApp de contacto, formato internacional sin signos (ej. 5215512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endpoint opcional al que se enviarán los leads (Zapier, Make, n8n, CRM, etc.)
# Si se deja vacío, submitLead() solo hace log local y no falla el formulario.
LEADS_WEBHOOK_URL=

# ID de medición de Google Analytics 4 (formato G-XXXXXXX). Opcional: sin él,
# los eventos de conversión solo se registran en window.dataLayer.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# URL pública del sitio en producción (ej. https://miguel-jarquin.com), sin
# slash final. Se usa para resolver las imágenes de Open Graph/Twitter.
NEXT_PUBLIC_SITE_URL=

# Opcional: habilita clasificación con IA real (Claude) de la tarea repetitiva
# en /diagnostico. Sin ella, esa pregunta se clasifica con una heurística de
# palabras clave (app/api/diagnostico/clasificar cae de vuelta a eso solo).
ANTHROPIC_API_KEY=

# Opcional: habilita el envío de cada lead por correo vía Resend
# (https://resend.com). Sin ella, submitLead() no envía email (solo webhook,
# si está configurado, o log local).
RESEND_API_KEY=

# Opcional: a dónde llegan los correos de leads. Por defecto usa el email de
# profile.contact (data/profile.ts).
LEADS_EMAIL_TO=

# Opcional: remitente de los correos de leads, formato "Nombre <email>". Por
# defecto usa el dominio de pruebas compartido de Resend (onboarding@resend.dev),
# válido solo mientras no se verifique un dominio propio en Resend.
LEADS_EMAIL_FROM=
